.DS_Store
**/.godot/
*.log
__pycache__/
*.pyc
.venv/

# Copias automáticas de Blender; el original .blend sí se versiona.
*.blend1
*.blend2

# Scratch work is kept outside the versioned application.
/work/

# Credencial de un servicio de terceros: se toma de la propia captura, no se publica.
tools/en_vivo.local.json

# Direcciones del alimentador GTFS de TRANSMILENIO. La fuente se nombra en el repositorio; su
# dirección se configura aquí y no se versiona.
tools/gtfs.local.json

# El paquete GTFS se vuelve a publicar a diario y pesa 121 MB: se guarda el manifiesto con su
# SHA-256 y las tablas reducidas, no el zip.
data/raw/gtfs/*.zip

# Las capturas del alimentador en vivo crecen ~50 MB al día. Se versiona el informe que sale de
# ellas, en data/processed, no las lecturas. Sin anclar a la raíz: si alguien la lanza desde otro
# directorio, las lecturas siguen quedando fuera.
**/rt_capture/
